# Copy to backend/.env and fill in. .env is gitignored.

# --- Claude (hackathon gateway) ---
ANTHROPIC_BASE_URL=https://ai.hack.lawhive.co.uk
ANTHROPIC_AUTH_TOKEN=sk-...        # bearer token (NOT api_key)
ANTHROPIC_MODEL=vertex_ai/claude-opus-4-7

# --- Voice (optional) ---
OPENAI_API_KEY=sk-...             # enables voice transcription (Whisper)

# --- Gmail search (optional; without it /api/connect-gmail returns a mock) ---
# Google Cloud Console -> enable Gmail API -> OAuth consent screen (External, add
# yourself as a test user, scope .../auth/gmail.readonly) -> Credentials -> OAuth
# client ID (Web application) with redirect URI http://localhost:5001/api/gmail/callback
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
GMAIL_REDIRECT_URI=http://localhost:5001/api/gmail/callback
